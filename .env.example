# bash-arena — variables de entorno
# Copia este archivo a .env y ajusta lo que necesites.

# --- Backend ---
PORT=8080
# Secreto用来 para derivar las flags por sesión (HMAC). En producción, cambia esto.
ARENA_FLAG_SECRET=change-me-please
# Máximo de sesiones simultáneas (global y por IP)
ARENA_MAX_SESSIONS=8
ARENA_MAX_SESSIONS_PER_IP=2
# Tiempo de inactividad (min) y duración máxima de sesión (min)
ARENA_IDLE_TIMEOUT_MIN=15
ARENA_SESSION_MAX_MIN=90
# Límites del contenedor por sesión
ARENA_CONTAINER_MEM_MB=256
ARENA_CONTAINER_CPU=0.5
ARENA_CONTAINER_PIDS=128
# Ruta al socket de Docker en el host
ARENA_DOCKER_SOCKET=/var/run/docker.sock

# --- Frontend (build del docs-site / client) ---
VITE_BASE=/bash-arena/
